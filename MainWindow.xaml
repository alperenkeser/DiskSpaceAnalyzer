<Window x:Class="DiskAlanAnaliz.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Disk Alan Analiz"
        Width="1180"
        Height="780"
        MinWidth="850"
        MinHeight="600"
        Background="#F4F6F9"
        Icon="pack://application:,,,/Resources/AppIcon.ico"
        FontFamily="Segoe UI"
        Foreground="#1F2937">
    <Window.Resources>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E5EAF0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="18"/>
        </Style>

        <Style x:Key="DriveSummaryCard" TargetType="Border" BasedOn="{StaticResource CardBorder}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding DriveInfo.DriveLetter}" Value="C:">
                    <Setter Property="Background" Value="#F1F6FF"/>
                    <Setter Property="BorderBrush" Value="#DCE8FF"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding DriveInfo.DriveLetter}" Value="D:">
                    <Setter Property="Background" Value="#F1F8F4"/>
                    <Setter Property="BorderBrush" Value="#DDEDE3"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding DriveInfo.DriveLetter}" Value="E:">
                    <Setter Property="Background" Value="#F6F3FB"/>
                    <Setter Property="BorderBrush" Value="#E8E0F5"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding DriveInfo.DriveLetter}" Value="F:">
                    <Setter Property="Background" Value="#FBF7EF"/>
                    <Setter Property="BorderBrush" Value="#F0E7D3"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#D9E0E8"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F3F6FA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="BorderBrush" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1D4ED8"/>
                    <Setter Property="BorderBrush" Value="#1D4ED8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="190"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#FAFBFC"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="RowHeight" Value="40"/>
            <Setter Property="ColumnHeaderHeight" Value="38"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#EEF1F5"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#E8EDF3"/>
        </Style>

        <DataTemplate x:Key="SortableColumnHeaderTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="SortIndicator"
                           Grid.Column="1"
                           Text="▲"
                           Visibility="Collapsed"
                           Margin="8,0,0,0"
                           FontSize="10"
                           FontWeight="Bold"
                           Foreground="#2563EB"
                           VerticalAlignment="Center"/>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding SortDirection, RelativeSource={RelativeSource AncestorType={x:Type DataGridColumnHeader}}}"
                             Value="Ascending">
                    <Setter TargetName="SortIndicator" Property="Text" Value="▲"/>
                    <Setter TargetName="SortIndicator" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding SortDirection, RelativeSource={RelativeSource AncestorType={x:Type DataGridColumnHeader}}}"
                             Value="Descending">
                    <Setter TargetName="SortIndicator" Property="Text" Value="▼"/>
                    <Setter TargetName="SortIndicator" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Foreground" Value="#334155"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F6FF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E8F0FF"/>
                    <Setter Property="Foreground" Value="#1D4ED8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ApplicationRowStyle"
               TargetType="DataGridRow"
               BasedOn="{StaticResource {x:Type DataGridRow}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding InstallDrive}" Value="C:">
                    <Setter Property="Background" Value="#E7EEFF"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding InstallDrive}" Value="D:">
                    <Setter Property="Background" Value="#E4F2E8"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding InstallDrive}" Value="E:">
                    <Setter Property="Background" Value="#EFE7FB"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding InstallDrive}" Value="F:">
                    <Setter Property="Background" Value="#FFF0DA"/>
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#DCE8F8"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#C9DAFF"/>
                    <Setter Property="Foreground" Value="#1D4ED8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,22">
            <StackPanel>
                <TextBlock Text="Disk Alan Analiz"
                           FontSize="25"
                           FontWeight="Bold"
                           Foreground="#172033"/>
                <TextBlock Text="Sürücü kullanımını inceleyin ve alanı güvenle yönetin."
                           Margin="0,5,0,0"
                           FontSize="13"
                           Foreground="#738096"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="0"
                          ItemsSource="{Binding Drives}"
                          SelectedItem="{Binding SelectedDrive}">
                    <ComboBox.Style>
                        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                    <Setter Property="IsEnabled" Value="False"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsCleaning}" Value="True">
                                    <Setter Property="IsEnabled" Value="False"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ComboBox.Style>
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding VolumeLabel}" Margin="8,0,0,0" Foreground="#738096"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Column="1"
                        Content="{Binding ScanButtonText}"
                        Command="{Binding StartScanCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Margin="12,0,8,0"/>
                <Button Grid.Column="2"
                        Content="İptal"
                        Command="{Binding CancelScanCommand}"
                        IsEnabled="{Binding CanCancelScan}"
                        Margin="0"/>
                <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="16,0,2,0">
                    <TextBlock Text="{Binding StatusMessage}"
                               HorizontalAlignment="Right"
                               Foreground="#64748B"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding StatusMessage}"/>
                    <TextBlock Text="{Binding LastScanDisplay}"
                               Margin="0,4,0,0"
                               HorizontalAlignment="Right"
                               FontSize="11"
                               Foreground="#94A3B8"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource DriveSummaryCard}" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                    <TextBlock Text="{Binding DriveInfo.DriveLetter}"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#172033"/>
                    <TextBlock Text="{Binding DriveInfo.VolumeName}"
                               Margin="0,3,0,12"
                               FontSize="12"
                               Foreground="#738096"/>
                    <ProgressBar Height="7"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding DriveInfo.UsagePercentage}"
                                 Background="#E9EEF5"
                                 Foreground="#3B82F6"
                                 BorderThickness="0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Kullanılan" FontSize="12" Foreground="#738096"/>
                    <TextBlock Text="{Binding DriveInfo.UsedSpaceDisplay}" Margin="0,5,0,0" FontSize="17" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="Boş alan" FontSize="12" Foreground="#738096"/>
                    <TextBlock Text="{Binding DriveInfo.FreeSpaceDisplay}" Margin="0,5,0,0" FontSize="17" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                    <TextBlock Text="Toplam" FontSize="12" Foreground="#738096"/>
                    <TextBlock Text="{Binding DriveInfo.TotalSizeDisplay}" Margin="0,5,0,0" FontSize="17" FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>
        </Border>

        <ProgressBar Grid.Row="3"
                     Height="3"
                     Margin="2,0,2,10"
                     IsIndeterminate="{Binding IsBusy}"
                     Foreground="#3B82F6"
                     Background="#E5EAF0"
                     BorderThickness="0">
            <ProgressBar.Style>
                <Style TargetType="ProgressBar">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ProgressBar.Style>
        </ProgressBar>

        <TabControl Grid.Row="4" Background="Transparent" BorderThickness="0">
            <TabItem Header="Büyük Klasörler">
                <Border Style="{StaticResource CardBorder}" Padding="0" Margin="0,8,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DataGrid Grid.Row="0"
                                  ItemsSource="{Binding LargestFolders}"
                                  SelectedItem="{Binding SelectedFolder, Mode=TwoWay}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Klasör" HeaderTemplate="{StaticResource SortableColumnHeaderTemplate}" Binding="{Binding Name}" Width="200"/>
                                <DataGridTextColumn Header="Konum" HeaderTemplate="{StaticResource SortableColumnHeaderTemplate}" Binding="{Binding Path}" Width="*"/>
                                <DataGridTextColumn Header="Grup" HeaderTemplate="{StaticResource SortableColumnHeaderTemplate}" Binding="{Binding Category}" Width="145"/>
                                <DataGridTextColumn Header="Etiket" HeaderTemplate="{StaticResource SortableColumnHeaderTemplate}" Binding="{Binding Tags}" Width="145"/>
                                <DataGridTextColumn Header="Boyut" HeaderTemplate="{StaticResource SortableColumnHeaderTemplate}" Binding="{Binding SizeDisplay}" Width="110"/>
                                <DataGridTextColumn Header="Dosyalar" HeaderTemplate="{StaticResource SortableColumnHeaderTemplate}" Binding="{Binding FileCount, StringFormat={}{0:N0}}" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <DockPanel Grid.Row="1" Margin="16,10">
                            <TextBlock Text="Gruplar ve etiketler klasör yoluna göre tahmin edilir."
                                       VerticalAlignment="Center"
                                       Foreground="#8491A3"
                                       FontSize="12"/>
                            <Button Content="Klasöre Git"
                                    Command="{Binding OpenSelectedFolderCommand}"
                                    DockPanel.Dock="Right"
                                    Margin="8,0,0,0"/>
                        </DockPanel>
                    </Grid>
                </Border>
            </TabItem>

            <TabItem Header="Yüklü Uygulamalar">
                <Border Style="{StaticResource CardBorder}" Padding="0" Margin="0,8,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DataGrid Grid.Row="0"
                                  ItemsSource="{Binding InstalledApplications}"
                                  SelectedItem="{Binding SelectedApplication, Mode=TwoWay}"
                                  RowStyle="{StaticResource ApplicationRowStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Uygulama" HeaderTemplate="{StaticResource SortableColumnHeaderTemplate}" Binding="{Binding Name}" Width="2*"/>
                                <DataGridTextColumn Header="Sürücü"
                                                    HeaderTemplate="{StaticResource SortableColumnHeaderTemplate}"
                                                    Binding="{Binding InstallDrive}"
                                                    SortMemberPath="InstallDrive"
                                                    Width="75"/>
                                <DataGridTextColumn Header="Yayıncı" HeaderTemplate="{StaticResource SortableColumnHeaderTemplate}" Binding="{Binding Publisher}" Width="*"/>
                                <DataGridTextColumn Header="Boyut"
                                                    HeaderTemplate="{StaticResource SortableColumnHeaderTemplate}"
                                                    Binding="{Binding SizeDisplay}"
                                                    SortMemberPath="Size"
                                                    Width="110"/>
                                <DataGridTextColumn Header="Sürüm" HeaderTemplate="{StaticResource SortableColumnHeaderTemplate}" Binding="{Binding Version}" Width="110"/>
                                <DataGridTextColumn Header="Kurulum Konumu" HeaderTemplate="{StaticResource SortableColumnHeaderTemplate}" Binding="{Binding InstallLocation}" Width="2*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <DockPanel Grid.Row="1" Margin="16,10">
                            <TextBlock Text="Bir uygulama seçerek klasörünü veya Windows uygulama ayarlarını açın."
                                       VerticalAlignment="Center"
                                       Foreground="#8491A3"
                                       FontSize="12"/>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                <Button Content="Kurulum klasörünü aç"
                                        Command="{Binding OpenApplicationFolderCommand}"/>
                                <Button Content="Windows uygulama ayarları"
                                        Command="{Binding OpenWindowsAppsSettingsCommand}"
                                        Margin="0"/>
                            </StackPanel>
                        </DockPanel>
                    </Grid>
                </Border>
            </TabItem>

            <TabItem Header="Temizlik Önerileri">
                <Border Style="{StaticResource CardBorder}" Padding="0" Margin="0,8,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DataGrid Grid.Row="0"
                                  ItemsSource="{Binding CleanupSuggestions}"
                                  SelectedItem="{Binding SelectedCleanupSuggestion, Mode=TwoWay}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Konum" HeaderTemplate="{StaticResource SortableColumnHeaderTemplate}" Binding="{Binding Path}" Width="2*"/>
                                <DataGridTextColumn Header="İçerik" HeaderTemplate="{StaticResource SortableColumnHeaderTemplate}" Binding="{Binding Reason}" Width="*"/>
                                <DataGridTextColumn Header="Boyut" HeaderTemplate="{StaticResource SortableColumnHeaderTemplate}" Binding="{Binding SizeDisplay}" Width="110"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <DockPanel Grid.Row="1" Margin="16,10">
                            <TextBlock Text="Silme işleminden önce onayınız istenir."
                                       VerticalAlignment="Center"
                                       Foreground="#8491A3"
                                       FontSize="12"/>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                <Button Content="Klasöre Git"
                                        Command="{Binding OpenInExplorerCommand}"
                                        CommandParameter="{Binding SelectedCleanupSuggestion.Path}"/>
                                <Button Content="Temizle"
                                        Command="{Binding CleanSuggestionCommand}"
                                        Background="#FFF7ED"
                                        BorderBrush="#FED7AA"
                                        Foreground="#C2410C"
                                        Margin="0"/>
                            </StackPanel>
                        </DockPanel>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
